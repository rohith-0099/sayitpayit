# Copy to apps/web/.env.local and fill in. Never commit real values.
# PayPal: SANDBOX ONLY (https://api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI (free tiers)
GEMINI_API_KEY=
# Optional: comma-separated fallback order (default: gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash)
GEMINI_MODELS=
# Optional: TTS fallback for languages Kokoro doesn't speak (default voice Achernar)
GEMINI_TTS_VOICE=
GEMINI_TTS_MODELS=
GROQ_API_KEY=

# Database (matches docker-compose.yml for local dev)
DATABASE_URL=postgres://sayitpayit:sayitpayit_local@localhost:5432/sayitpayit

# Guardian service
GUARDIAN_URL=http://localhost:8000
# Shared secret: set the same value on the web app and the Guardian service (optional locally)
GUARDIAN_API_KEY=

# App
APP_URL=http://localhost:3000

# Guardian service (services/guardian) env, all optional:
# KOKORO_VOICE=af_heart      # agent's English voice (try af_bella)
# SPEAKER_THRESHOLD=0.25     # voice match
# SPEAKER_REJECT=0.15        # below this = different person
# SPOOF_THRESHOLD=0.9        # AASIST-L 'recording/AI voice' signal
