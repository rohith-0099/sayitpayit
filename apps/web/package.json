{
  "name": "sayitpayit-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:payout": "node --env-file=.env.local scripts/test-payout.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "node --conditions=react-server --import tsx --test \"src/**/*.test.ts\"",
    "webhook:setup": "node --env-file=.env.local scripts/setup-webhook.mjs",
    "paypal:reset-token": "node --env-file=.env.local scripts/reset-paypal-token.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "build:verify": "NEXT_DIST_DIR=.next-verify next build",
    "demo:reset": "tsx scripts/demo-reset.ts && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@paypal/paypal-js": "^11.3.0",
    "ag-studio": "^3.1.0",
    "ag-studio-react": "^3.1.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
